{
  "name": "mage-web-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "cd ../Mage.Server/release && mvn -f ../../pom.xml -pl Mage.Server -am -DskipTests install && mvn -f ../../pom.xml -pl Mage.Server -Dexec.mainClass=mage.server.Main -Dexec.cleanupDaemonThreads=false exec:java",
    "dev:all": "bash scripts/dev-with-server.sh",
    "dev:kill": "bash scripts/kill-dev-servers.sh",
    "build": "tsc -b && vite build",
    "android:build": "tsc -b && vite build --mode android && cap sync android",
    "android": "npm run android:build && cd android && ./gradlew assembleRelease",
    "size": "node scripts/check-bundle-size.mjs",
    "test": "vitest run && npm run test:a11y",
    "test:a11y": "node scripts/check-accessibility.mjs",
    "test:e2e": "playwright test e2e",
    "test:e2e:ci": "MAGE_WEB_E2E_PREVIEW=1 playwright test e2e --project=chromium-desktop",
    "test:e2e:app": "MAGE_E2E_REQUIRE_SERVER=1 playwright test e2e/app- --project=chromium-desktop --workers=1",
    "test:e2e:import": "MAGE_E2E_REQUIRE_SERVER=1 playwright test e2e/deck-import.spec.ts --project=chromium-desktop --workers=1",
    "lint": "eslint . --max-warnings 0",
    "perf": "bash ../ops/perf/perf.sh",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tanstack/react-query": "^5.104.1",
    "lucide-react": "^1.23.0",
    "mana-font": "^1.18.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.12.0",
    "three": "^0.186.1",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "8.5.2",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "happy-dom": "^20.14.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^5.0.3"
  }
}
