# The Android app (npm run android): its shell ships inside the app, and it talks to the Playmat site over the network.
# PLAYMAT_HOST names that site. Build for another server by setting it in the shell, e.g. Multivac:
#   PLAYMAT_HOST=playmat.multivac.club npm run android
# The server must list https://localhost in XMAGE_ALLOWED_ORIGINS, and its Turnstile widget (if any) must allow localhost.
PLAYMAT_HOST=playmat.deimos.studio
VITE_NATIVE=1
VITE_PUBLIC_ORIGIN=https://${PLAYMAT_HOST}
VITE_MAGE_SERVER_URL=wss://${PLAYMAT_HOST}/ws
VITE_IMAGE_PROXY=https://${PLAYMAT_HOST}/img
