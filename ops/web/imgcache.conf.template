# Caching proxy for Scryfall card pictures and API lookups (the "imgcache" service).
# The official nginx image renders this template into /etc/nginx/conf.d/default.conf at start, filling the
# ${IMGCACHE_*} variables from the environment (docker-compose.yml gives every one a default).
#
#   /img/cards/...  -> https://cards.scryfall.io/...   card pictures, cached a year
#   /img/backs/...  -> https://backs.scryfall.io/...   card backs (the classic back setting), cached a year
#   /img/api/...    -> https://api.scryfall.com/...    GET lookups (and image redirects), cached 24 hours
#   POST /img/api/cards/collection                      batch lookups, cached 24 hours keyed on the request body
#
# Only cache misses reach Scryfall. API misses go through an internal server on 127.0.0.1:8081 that holds them to
# Scryfall's requested rate for the whole site, so cached answers are never slowed down by the limit.

# Docker's embedded DNS; upstream names are re-resolved instead of pinned at start
resolver 127.0.0.11 ipv6=off valid=300s;
resolver_timeout 5s;

proxy_cache_path /var/cache/nginx/scryfall/images levels=1:2 keys_zone=scryfall_images:50m
                 max_size=${IMGCACHE_IMAGES_MAX_SIZE} inactive=365d use_temp_path=off;
proxy_cache_path /var/cache/nginx/scryfall/api levels=1:2 keys_zone=scryfall_api:20m
                 max_size=${IMGCACHE_API_MAX_SIZE} inactive=365d use_temp_path=off;

# one bucket for the whole site: this limits what we send to Scryfall, not what any one player sends
limit_req_zone $server_port zone=scryfall_upstream:1m rate=${IMGCACHE_API_RATE};
limit_req_status 429;

# Scryfall's API answers carry long headers (CORS, rate and tracing fields); past nginx's default 4k buffer a lookup
# fails with 502 "upstream sent too big header", and the client then treats a whole batch of cards as missing
proxy_buffer_size 32k;
proxy_buffers 16 32k;
proxy_busy_buffers_size 64k;

# timings and cache hits, to tell a slow Scryfall from a slow host
log_format imgcache '$remote_addr [$time_local] "$request" $status $body_bytes_sent '
                    'rt=$request_time urt=$upstream_response_time cache=$upstream_cache_status';

# --- what Caddy talks to ------------------------------------------------------------------------------------
server {
    listen 8080;
    server_name _;
    server_tokens off;
    access_log /var/log/nginx/access.log imgcache;
    # redirects stay relative ("/img/cards/..."): behind Caddy this server's own host and port mean nothing
    absolute_redirect off;

    # the collection lookup body (75 identifiers, a few kB) must stay in memory to be part of the cache key
    client_body_buffer_size 64k;
    client_max_body_size 64k;
    client_body_in_single_buffer on;

    # Note: a location with any proxy_set_header / proxy_hide_header / add_header of its own stops inheriting
    # these, so locations only vary the headers through the $imgcache_* variables.
    proxy_http_version 1.1;
    proxy_set_header Host $imgcache_host;
    proxy_set_header Connection "";
    proxy_set_header Cookie "";
    proxy_set_header Authorization "";
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Real-IP "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-Proto "";
    # Scryfall asks for a descriptive User-Agent and an Accept header on every request
    proxy_set_header User-Agent "PlaymatXMageImageCache/1.0 (+https://github.com/arcanite24/playmat)";
    proxy_set_header Accept $imgcache_accept;
    # cache one uncompressed copy; Caddy compresses for the browser
    proxy_set_header Accept-Encoding "";
    proxy_hide_header Set-Cookie;
    proxy_ignore_headers Set-Cookie Cache-Control Expires Vary;
    proxy_cache_lock on;
    proxy_cache_lock_timeout 15s;
    proxy_cache_background_update on;
    proxy_cache_use_stale error timeout updating invalid_header http_429 http_500 http_502 http_503 http_504;
    proxy_connect_timeout 10s;
    proxy_read_timeout 30s;
    add_header X-Cache-Status $upstream_cache_status always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # card pictures and card backs from the CDNs (no rate limit upstream)
    location ~ ^/img/(cards|backs)/ {
        limit_except GET { deny all; }
        # (every set before the rewrite: "break" ends the rewrite directives, and replaces $1)
        set $scryfall_cdn $1.scryfall.io;
        set $imgcache_host $1.scryfall.io;
        set $imgcache_accept "*/*";
        # a variable in proxy_pass re-resolves the name; the rewritten URI is passed (re-escaped) as is
        rewrite ^/img/[a-z]+/(.*)$ /$1 break;
        proxy_pass https://$scryfall_cdn;
        proxy_ssl_server_name on;
        proxy_ssl_name $scryfall_cdn;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 4;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

        proxy_cache scryfall_images;
        proxy_cache_key $request_uri;
        # pictures never change at a given address (Scryfall changes the query when it replaces one), so a copy stays
        # good for a year: a server prepared with warm-images.mjs keeps its pictures offline without asking again
        proxy_cache_valid 200 301 302 365d;
        proxy_cache_valid 404 1d;
        proxy_hide_header Set-Cookie;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        add_header Cache-Control "public, max-age=2592000, immutable";
        add_header X-Cache-Status $upstream_cache_status always;
    }

    # batch lookups: POST, cached by body
    location = /img/api/cards/collection {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:8081/cards/collection;
        set $imgcache_host api.scryfall.com;
        set $imgcache_accept "application/json";

        proxy_cache scryfall_api;
        proxy_cache_methods GET HEAD POST;
        proxy_cache_key "$request_method$request_uri$request_body";
        proxy_cache_valid 200 24h;
    }

    # other API lookups, including the per-card image links that redirect to the CDN
    location /img/api/ {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:8081/;
        set $imgcache_host api.scryfall.com;
        set $imgcache_accept "application/json";
        # keep the browser on this proxy when Scryfall redirects to its CDN
        proxy_redirect https://cards.scryfall.io/ /img/cards/;

        proxy_cache scryfall_api;
        proxy_cache_key $request_uri;
        proxy_cache_valid 200 301 302 24h;
        proxy_cache_valid 404 1h;
    }

    location / {
        return 404;
    }
}

# --- internal: the only way out to api.scryfall.com, rate limited ---------------------------------------------
server {
    listen 127.0.0.1:8081;
    server_name _;
    server_tokens off;
    access_log off;
    client_body_buffer_size 64k;
    client_max_body_size 64k;

    location / {
        # queue up to the burst (delayed, not refused); beyond that 429, which the client retries with backoff
        limit_req zone=scryfall_upstream burst=${IMGCACHE_API_BURST};
        set $scryfall_api api.scryfall.com;
        proxy_pass https://$scryfall_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $scryfall_api;
        proxy_ssl_server_name on;
        proxy_ssl_name $scryfall_api;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 4;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_redirect off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
    }
}
