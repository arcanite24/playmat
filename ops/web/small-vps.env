
# --- Small VPS preset (1 vCPU / 1 GB RAM), appended from ops/web/small-vps.env ---------------------
# Heap and GC size themselves (about 400 MB, Serial). One CPU keeps about three games responsive
# when an AI plays in each; a fourth game waits for a free slot and its players are told so.
XMAGE_MAX_GAME_THREADS=3
XMAGE_MAX_AI_OPPONENTS=3
# The Monte Carlo AI would keep the one CPU busy for its whole think time; one AI search at a time.
XMAGE_MONTE_CARLO=false
XMAGE_AI_THREADS=1
# Idle players concede sooner, so abandoned games give their slot back.
XMAGE_MAX_SECONDS_IDLE=300
# A small disk: fewer replays and a smaller picture cache.
XMAGE_REPLAY_MAX=150
IMGCACHE_IMAGES_MAX_SIZE=5g
IMGCACHE_API_MAX_SIZE=256m
