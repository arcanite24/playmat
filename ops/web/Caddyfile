{
	# rate_limit comes from github.com/mholt/caddy-ratelimit (built in by Dockerfile.web)
	order rate_limit before basic_auth

	# A browser opening the site by IP address sends no server name, and inside Docker the connection's local
	# address is the container's, so Caddy couldn't pick a certificate: this name's is used then ($LAN_IP when
	# set, else $DOMAIN; Compose fills it in)
	default_sni {$TLS_DEFAULT_SNI:localhost}

	# the http:// site at the end does the HTTP to HTTPS redirect (Caddy's own would win for the site's hosts and
	# assume port 443)
	auto_https disable_redirects

	servers :443 {
		# plain http:// typed at the HTTPS port (a non-standard one, like 8443) is redirected, not refused
		listener_wrappers {
			http_redirect
			tls
		}
		trusted_proxies static {$UPSTREAM_PROXIES:127.0.0.1/32}
		trusted_proxies_strict
	}

	# A reverse proxy in front (UPSTREAM_PROXIES, e.g. the host's main Caddy serving PROXIED_HOST) is trusted to
	# say who the client is, so {client_ip} is the player rather than the proxy. Only peers in that range are
	# believed; anyone else's X-Forwarded-For is ignored.
	servers :80 {
		trusted_proxies static {$UPSTREAM_PROXIES:127.0.0.1/32}
		trusted_proxies_strict
	}
}

# The site: the web client, /ws forwarded to the XMage server and /img to the Scryfall image cache.
(site) {
	encode zstd gzip

	# Per client address: the peer, or the client a trusted upstream proxy names (see UPSTREAM_PROXIES).
	# Over the limit: 429 with Retry-After. The server also caps concurrent game connections per address.
	rate_limit {
		zone ws {
			match {
				path /ws*
			}
			key {client_ip}
			events {$WS_RATE_LIMIT:30}
			window {$WS_RATE_WINDOW:1m}
		}
		# Scryfall lookups that may miss the cache (pictures from the CDN are not limited)
		zone img_api {
			match {
				path /img/api/*
			}
			key {client_ip}
			events {$IMG_API_RATE_LIMIT:300}
			window {$IMG_API_RATE_WINDOW:1m}
		}
		# payment webhooks and the public goal (the server limits them per address too)
		zone hooks {
			match {
				path /hooks/* /public/*
			}
			key {client_ip}
			events {$HOOKS_RATE_LIMIT:60}
			window {$HOOKS_RATE_WINDOW:1m}
		}
	}

	# the game connection: WebSocket upgrade to the server's bridge port
	handle /ws* {
		reverse_proxy xmage:17172 {
			# The server limits and logs by client address. It trusts these headers only from the
			# proxy network (XMAGE_TRUSTED_PROXIES). Both are set to the client address alone (the peer, or the
			# client a trusted upstream proxy named), replacing whatever the client sent.
			header_up X-Forwarded-For {client_ip}
			header_up X-Real-IP {client_ip}
		}
	}

	# support payments: Ko-fi's and GitHub Sponsors' webhooks, POST only, to the server's webhook listener (not
	# published on the host: Caddy reaches it on the compose network). The server checks each provider's token or
	# signature and limits the body size and the rate per client address.
	handle /hooks/* {
		@notPost not method POST
		respond @notPost 405
		reverse_proxy xmage:17174 {
			header_up X-Forwarded-For {client_ip}
			header_up X-Real-IP {client_ip}
		}
	}

	# the month's support goal as JSON for the project's site (GET; the server sets the cache and CORS headers)
	handle /public/* {
		@notRead not method GET HEAD OPTIONS
		respond @notRead 405
		reverse_proxy xmage:17174 {
			header_up X-Forwarded-For {client_ip}
			header_up X-Real-IP {client_ip}
		}
	}

	# card pictures and Scryfall lookups, cached by the imgcache service (nginx)
	handle /img/* {
		# the Android app (served from https://localhost) looks pictures up cross-origin; Scryfall's own API is
		# open to every origin too. Set after the proxy, replacing any copy Scryfall's response carried.
		header {
			>Access-Control-Allow-Origin "*"
			Access-Control-Allow-Methods "GET, POST, OPTIONS"
			Access-Control-Allow-Headers "Content-Type"
			Access-Control-Max-Age "86400"
		}
		@preflight method OPTIONS
		respond @preflight 204
		reverse_proxy imgcache:8080
	}

	handle {
		root * /srv
		# hashed assets never change; the app shell always revalidates
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		# the service worker and the web manifest keep their names across releases, so browsers must revalidate
		# them to notice an update (browsers also cap a service worker's HTTP caching at a day)
		header /sw.js Cache-Control "no-cache"
		# the release's notes for the "What's new" dialog, written with each release build
		header /release-notes.json Cache-Control "no-cache"
		header /manifest.webmanifest {
			Cache-Control "no-cache"
			Content-Type "application/manifest+json"
		}
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Scryfall origins stay allowed for builds without the image proxy (VITE_IMAGE_PROXY unset); the exported
		# link lists also point the card back at upload.wikimedia.org. wss: covers a client built with
		# VITE_MAGE_SERVER_URL pointing at another host.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cards.scryfall.io https://*.scryfall.io https://api.scryfall.com https://c1.scryfall.com https://svgs.scryfall.io https://upload.wikimedia.org; font-src 'self' data:; connect-src 'self' wss: https://api.scryfall.com https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; worker-src 'self' blob:; manifest-src 'self'"
	}
}

# The sites: TLS_MODE picks them (sites-https.caddy, the default, or sites-external.caddy behind your own reverse
# proxy). Both import the site above.
import sites-{$TLS_MODE:https}.caddy
