# Mana@Home coordinator settings (ops/swarm/README.md). Copy to mana.env; never commit mana.env.
SWARM_PUBLIC_URL=https://mana.deimos.studio
SWARM_R2_ACCOUNT=
SWARM_R2_BUCKET=mana-intake
SWARM_R2_KEY_ID=
SWARM_R2_SECRET=
# a local store instead of R2 (a LAN swarm): uncomment and leave the R2 settings empty
# SWARM_STORE=/data/store
