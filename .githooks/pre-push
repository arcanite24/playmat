#!/usr/bin/env bash
# Runs ops/ci/check.sh (what CI would run for the files you changed) before a branch is pushed.
# Enable once per clone (worktrees share it): git config core.hooksPath .githooks
# Skip it for one push: git push --no-verify
set -uo pipefail

ROOT=$(git rev-parse --show-toplevel) || exit 0
CHECK="$ROOT/ops/ci/check.sh"
[ -x "$CHECK" ] || exit 0

HEAD_SHA=$(git rev-parse HEAD)
ZERO=0000000000000000000000000000000000000000
status=0
checked=""

# one line per pushed ref: <local ref> <local sha> <remote ref> <remote sha>
while read -r local_ref local_sha _remote_ref _remote_sha; do
  case "$local_ref" in refs/heads/*|HEAD) ;; *) continue ;; esac   # tags and other refs
  [ "$local_sha" = "$ZERO" ] && continue                           # a branch deletion
  case " $checked " in *" $local_sha "*) continue ;; esac
  checked="$checked $local_sha"
  if [ "$local_sha" != "$HEAD_SHA" ]; then
    echo "pre-push: ${local_ref#refs/heads/} isn't the checked-out commit, so its checks can't run here; skipping it." >&2
    echo "pre-push: check it with: git switch ${local_ref#refs/heads/} && ops/ci/check.sh" >&2
    continue
  fi
  "$CHECK" --hook --rev "$local_sha" </dev/null || status=1
done

exit $status
