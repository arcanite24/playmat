    <profiles>
        <!-- web client: generate TypeScript types for every JSON payload of the WebSocket bridge
             mvn -pl Mage.Server -P web-client-types process-classes -->
        <profile>
            <id>web-client-types</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>cz.habarta.typescript-generator</groupId>
                        <artifactId>typescript-generator-maven-plugin</artifactId>
                        <version>3.2.1263</version>
                        <executions>
                            <execution>
                                <id>generate-web-client-types</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <jsonLibrary>gson</jsonLibrary>
                            <outputKind>module</outputKind>
                            <outputFileType>implementationFile</outputFileType>
                            <outputFile>../Mage.Web.Client/src/protocol/generated/views.ts</outputFile>
                            <mapEnum>asUnion</mapEnum>
                            <mapDate>asNumber</mapDate>
                            <optionalProperties>all</optionalProperties>
                            <optionalPropertiesDeclaration>questionMark</optionalPropertiesDeclaration>
                            <noFileComment>true</noFileComment>
                            <sortDeclarations>true</sortDeclarations>
                            <customTypeMappings>
                                <mapping>java.util.UUID:string</mapping>
                            </customTypeMappings>
